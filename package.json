{
  "name": "pcg-gen",
  "sideEffects": false,
  "version": "1.1.0",
  "description": "A permuted congruential generator generator",
  "main": "./dist/index.js",
  "files": [
    "/dist/",
    "!/dist/**/__tests__/*.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "prepare": "husky && npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "prng",
    "pcg",
    "random",
    "generator"
  ],
  "homepage": "https://github.com/philihp/pcg-gen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philihp/pcg-gen.git"
  },
  "bugs": {
    "url": "https://github.com/philihp/pcg-gen/issues"
  },
  "author": "Philihp Busby <philihp@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "8.0.4",
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-typescript": "8.0.1",
    "@philihp/prettier-config": "1.0.0",
    "@types/jest": "30.0.0",
    "fast-shuffle": "6.2.1",
    "husky": "9.1.7",
    "jest": "30.5.0",
    "lint-staged": "17.4.1",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "dist/"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "node"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,json,ts}": [
      "oxlint --fix"
    ]
  },
  "prettier": "@philihp/prettier-config"
}
